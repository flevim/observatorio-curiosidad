# Copia este archivo a .env en el servidor (no lo subas al repositorio) y completa los valores.

# Contacto que exige Wikimedia en el User-Agent (correo o URL real).
OBSERVATORIO_CONTACT=tu-correo@ejemplo.org

# Pausa entre peticiones a Wikimedia (segundos). En el servidor se usa un valor mayor para evitar el 429.
OBSERVATORIO_MIN_INTERVAL=0.5

# Orígenes desde donde la web puede llamar a la API (separados por coma).
OBSERVATORIO_CORS_ORIGINS=https://flevim.github.io

# Zona horaria del servidor (la actualización diaria corre a la hora de OnCalendar en el timer).
TZ=America/Santiago
