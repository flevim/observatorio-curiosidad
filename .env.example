# Copia este archivo a .env y completa los valores. No contiene secretos.

# Contacto para el User-Agent que exige la política de Wikimedia
# (un correo, una URL o una página de usuario de Wikimedia).
OBSERVATORIO_CONTACT=tu-correo@ejemplo.org

# Pausa mínima entre llamadas a Wikimedia, en segundos (las peticiones nunca van en paralelo).
OBSERVATORIO_MIN_INTERVAL=0.1

# Puerto de la API (FastAPI) y de la web en desarrollo.
OBSERVATORIO_API_PORT=8010

# Futuro: clave gratuita de OpenAlex (obligatoria desde febrero de 2026). Ver docs/openalex.md.
# OPENALEX_API_KEY=

# Docker: hora diaria de actualización (HH:MM) y zona horaria del contenedor.
OBSERVATORIO_HORA_DIARIA=09:00
TZ=America/Santiago
# OBSERVATORIO_EJECUTAR_AL_INICIAR=1   # actualizar también al arrancar el contenedor
